# --- 資料庫 ---
POSTGRES_USER=moon
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=moonold
# api 服務用；docker compose 內主機名為 db
DATABASE_URL=postgres://moon:change-me-in-production@db:5432/moonold
# 這個 api replica 的連線池上限。多開幾個 replica 時，要跟 Postgres max_connections 對齊，避免連線耗盡
DATABASE_POOL_MAX=10

# --- API 服務 ---
API_PORT=3000
NODE_ENV=development

# --- OpenAI（AI 彩蛋信眾）---
# 只給 api service 使用，前端 build 絕不可帶入
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# 全站每日 AI 呼叫上限，超過就靜默 fallback 回預寫願望池
AI_DAILY_CAP=500

# --- 審核後台 ---
# 標準帳號密碼登入。兩個都要設，缺一個就當作沒設，後台整組不開放
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# --- 帳號（Google 登入）---
# Google Cloud Console → API 與服務 → 憑證 → OAuth 2.0 用戶端 ID（網頁應用程式）
# 已授權的 JavaScript 來源要加上 http://localhost:5173 與 http://localhost:8080
# 沒設就是「這台不開放登入」，遊戲其餘功能照常
GOOGLE_CLIENT_ID=
# session cookie 的簽章金鑰，至少 16 字元，正式環境務必換掉
SESSION_SECRET=change-this-to-a-long-random-string
APP_BASE_URL=http://localhost:5173
# 開發用假登入。只在 NODE_ENV=development 有作用，正式環境絕對不要開
ALLOW_DEV_LOGIN=false

# --- 寄信（願望被互動時通知作者）---
# 沒設 SMTP_HOST 就走 log transport：功能照跑，信只寫進 log 不真的寄
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=月老值班中 <no-reply@example.com>

# --- 濫用防治：IP 雜湊用的 salt（不儲存原始 IP）---
IP_HASH_SALT=change-me-as-well

# --- 社群願望投稿者頭像快取（MinIO）---
# 沒設全就整組停用，直接沿用 Google 提供的頭像網址，不影響登入
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=moon-old-avatars
# bucket 對外的公開讀取網址前綴（例如 CDN 或反向代理網域）；沒設就用 endpoint 直接拼
MINIO_PUBLIC_URL=
