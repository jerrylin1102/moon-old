{
  "name": "moon-old",
  "version": "0.1.0",
  "private": true,
  "description": "月老值班中 — 讓玩家坐上神座，體驗月老的一天",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@moon/web",
    "dev:api": "npm run dev --workspace=@moon/api",
    "build": "npm run build --workspace=@moon/web",
    "test": "npm run test --workspace=@moon/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:prod": "docker compose up --build"
  },
  "engines": {
    "node": ">=22"
  }
}
